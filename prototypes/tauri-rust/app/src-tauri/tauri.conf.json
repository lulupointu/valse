{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MontageProto",
  "version": "0.1.0",
  "identifier": "fr.solona.montage.proto",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Montage",
        "width": 1440,
        "height": 900,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
