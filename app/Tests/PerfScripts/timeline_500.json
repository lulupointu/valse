// Perf harness (scripts/perf.sh): 500 clips on 3 tracks + 300 items in the media bin — timeline scroll / zoom frame
// cost, inspector slider drag with live preview, ruler scrubbing, asset panel scrolling, memory peak.
{
  "project": "stress:500:300",
  "settle": 3,
  "steps": [
    {"metric": "memory"},
    {"metric": "launch"},
    {"perf": "timeline_scroll", "frames": 300, "dx": -40, "alternate": true, "period": 75},
    {"perf": "timeline_zoom", "frames": 120, "dy": 8, "modifiers": ["cmd"], "alternate": true, "period": 20},
    {"click": "id:toolbar.zoomFit"},
    {"perf": "timeline_scroll_fit", "frames": 120, "dx": -40, "alternate": true, "period": 30},
    {"snapshot": "stress-500", "element": "id:timeline"},
    {"perf": "assets_scroll", "scroll": "id:media.card.4", "dy": -24, "frames": 120, "alternate": true, "period": 40},
    {"click": "clip:main/3"},
    {"idle": 0.5},
    {"perf": "inspector_drag", "drag": "id:slider.Scale", "at": [0.15, 0.5], "toAt": [0.85, 0.5], "frames": 120},
    {"perf": "scrub", "drag": "time:2@ruler", "to": "time:40@ruler", "frames": 120},
    {"metric": "memory"},
    {"metric": "open_project"}
  ]
}
