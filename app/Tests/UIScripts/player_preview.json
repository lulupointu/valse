// Player library / source preview (W2-3): a click on an effect card loops it over 3 s at the playhead ("Previewing —
// Effects", the item's own timecode), Esc returns to the timeline with the playhead unchanged; a click on a media card
// previews that source ("Previewing — Video") and a click on the canvas exits. Nothing is added to the project.
{
  "project": "demo",
  "steps": [
    {"idle": 1},
    {"seek": 2},
    {"click": "id:asset.tab.effects"},
    {"click": "id:asset.tile.montage.effect.shake"},
    {"expect": [{"path": "ui.preview.kind", "equals": "effect"}, {"path": "ui.preview.duration", "approx": 3},
                {"path": "undo.depth", "equals": 0}, {"path": "playhead", "approx": 2}]},
    {"wait": 0.6},
    {"snapshot": "preview-effect", "element": "id:panel.player"},
    {"key": "escape"},
    {"expect": [{"path": "ui.preview", "exists": false}, {"path": "playhead", "approx": 2}, {"path": "undo.depth", "equals": 0}]},
    {"click": "id:asset.tab.media"},
    {"click": "id:media.card.1"},
    {"wait": 0.4},
    {"expect": [{"path": "ui.preview.kind", "equals": "video"}, {"path": "ui.preview.time", "approx": 0}]},
    {"snapshot": "preview-media", "element": "id:panel.player"},
    {"key": "space"},
    {"wait": 0.5},
    {"key": "space"},
    {"expect": [{"path": "ui.preview.time", "gt": 0.1}, {"path": "playhead", "approx": 2}]},
    {"click": "player:0.5,0.5"},
    {"expect": [{"path": "ui.preview", "exists": false}, {"path": "playhead", "approx": 2}]}
  ]
}
