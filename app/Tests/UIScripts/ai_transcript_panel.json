// W10: select a main-track clip, open Transcript-based editing from the toolbar (it replaces the asset panel), close it.
{
  "project": "demo",
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:toolbar.transcript"},
    {"expect": {"path": "ui.anchors", "contains": "transcript.panel"}},
    {"snapshot": "transcript-open", "element": "id:transcript.panel"},
    {"click": "id:transcript.close"},
    {"expect": {"path": "ui.anchors", "contains": "asset.tab.media"}}
  ]
}
