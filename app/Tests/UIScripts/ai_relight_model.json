// AI2: Relight with the Depth Anything V2 model (SKIPPED when it isn't installed; the no-model UX is ai_relight.json).
// Tick → depth pass in the background (progress line) → "Relight applied"; the player shows the lit clip.
{
  "project": "demo",
  "requires": {"models": ["coreml.depth-anything-v2-small"]},
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"click": "id:inspector.section.video.relight", "at": [0.035, 0.5]},
    {"expect": [{"path": "undo.name", "equals": "cmd.relight"}, {"path": "ui.relight.pending", "equals": 1},
                {"path": "ui.anchors", "notContains": "relight.needsModel"}]},
    // the depth pass: loading the Core ML model is one call with no progress (18 s cold on a quiet machine, > 90 s seen
    // under 10+ concurrent runs: the ANE compile goes through the system-wide aned), then progress moves every frame
    {"waitFor": {"path": "ui.relight.pending", "equals": 0, "timeout": 300}},
    {"expect": {"path": "ui.anchors", "notContains": "relight.progress"}},
    {"click": "id:relight.preset.object"},
    {"expect": {"path": "undo.name", "equals": "cmd.relight"}},
    {"snapshot": "relight-model-player", "element": "id:panel.player"},
    // untick through the checkbox's own id (scrolled into view, located again when the press is dispatched): the old
    // wheel scroll + offset click 22 pt above `relight.top` was aimed from frames read before the scroll had settled and
    // missed the checkbox under load (FLAKY-UI2)
    {"click": "id:inspector.check.video.relight"},
    {"waitFor": {"path": "undo.depth", "equals": 3, "timeout": 30}},
    {"expect": {"path": "ui.anchors", "notContains": "relight.preset.facial"}}
  ]
}
