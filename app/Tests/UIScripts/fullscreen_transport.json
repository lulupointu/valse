// PB-006b: full-screen overlay transport. Click on the seek bar jumps, drag scrubs, esc during a drag cancels it (full
// screen stays), drag-away = fine scrubbing, hover = time + background-rendered frame thumbnail, click on the picture =
// play / pause, editing keys are off, double-click on the picture leaves full screen.
{
  "project": "demo",
  "lang": "en",
  "steps": [
    {"click": "id:player.fullscreen"},
    {"waitFor": {"path": "ui.playerFullscreen.on", "equals": true, "timeout": 10}},
    {"expect": [{"path": "ui.playerFullscreen.controls", "equals": "visible"},
                {"path": "ui.anchors", "contains": "fullscreen.controls"},
                {"path": "ui.anchors", "contains": "fullscreen.exit"}]},
    {"dump": "entered"},
    {"click": "id:fullscreen.scrubber", "at": [0.5, 0.56]},
    {"waitFor": {"path": "playhead", "approx": 8.25, "tolerance": 0.1}},
    {"expect": {"path": "ui.playerFullscreen.scrubbing", "equals": false}},
    {"drag": "id:fullscreen.scrubber", "at": [0.2, 0.56], "to": "id:fullscreen.scrubber", "toAt": [0.8, 0.56], "steps": 10},
    {"waitFor": {"path": "playhead", "approx": 13.2, "tolerance": 0.1}},
    {"drag": "id:fullscreen.scrubber", "at": [0.4, 0.56], "to": "id:fullscreen.scrubber", "toAt": [0.6, 0.56], "steps": 6, "hold": true},
    {"waitFor": {"path": "ui.playerFullscreen.scrubbing", "equals": true}},
    {"expect": {"path": "ui.playerFullscreen.controls", "equals": "pinned"}},
    {"key": "escape"},
    {"waitFor": {"path": "ui.playerFullscreen.scrubbing", "equals": false}},
    {"waitFor": {"path": "playhead", "approx": 13.2, "tolerance": 0.1}},
    {"expect": {"path": "ui.playerFullscreen.on", "equals": true}},
    {"release": true},
    {"drag": "id:fullscreen.scrubber", "at": [0.5, 0.56], "by": [40, -300], "steps": 8, "hold": true},
    {"waitFor": {"path": "ui.playerFullscreen.fineScrub", "equals": "frame"}},
    {"expect": {"path": "ui.anchors", "contains": "fullscreen.fineScrub"}},
    {"snapshot": "fine-scrub", "element": "id:fullscreen.player"},
    {"release": true},
    {"waitFor": {"path": "ui.playerFullscreen.scrubbing", "equals": false}},
    {"expect": {"path": "playhead", "approx": 8.3, "tolerance": 0.3}},
    {"hover": "id:fullscreen.scrubber", "at": [0.3, 0.56]},
    {"waitFor": {"path": "ui.playerFullscreen.hoverTime", "approx": 4.95, "tolerance": 0.1}},
    {"expect": {"path": "ui.anchors", "contains": "fullscreen.hoverTime"}},
    {"waitFor": {"path": "ui.playerFullscreen.thumb", "equals": "ready", "timeout": 60}},
    {"expect": {"path": "ui.anchors", "contains": "fullscreen.hoverThumb"}},
    {"snapshot": "hover-thumbnail", "element": "id:fullscreen.player"},
    {"hover": "player:0.5,0.3"},
    {"waitFor": {"path": "ui.playerFullscreen.hoverTime", "equals": -1}},
    {"key": "q"},
    {"key": "cmd+b"},
    {"expect": [{"path": "main.clips.count", "equals": 3}, {"path": "ui.playerFullscreen.on", "equals": true}]},
    {"click": "player:0.5,0.3"},
    {"waitFor": {"path": "isPlaying", "equals": true}},
    {"click": "player:0.5,0.3"},
    {"waitFor": {"path": "isPlaying", "equals": false}},
    {"doubleClick": "player:0.5,0.3"},
    {"waitFor": {"path": "ui.playerFullscreen.on", "equals": false}},
    {"expect": {"path": "isPlaying", "equals": false}}
  ]
}
