// AI2 (AI-005 / TX-038): Inspector ▸ Captions ▸ Speakers on speaker-tagged captions (fixture: 6 captions, 2 speakers):
// rows with name + colour, speaker chips on the caption rows, colour change (one undo step), apply the selected
// caption's style to its speaker, remove the labels → "Identify speakers" button. The diarization itself is covered
// by SpeakerDiarizationTests (WeSpeaker model gated). Second part: Captions ▸ Auto captions ▸ ☐ Identify speakers.
{
  "project": "fixtures/speakers.montage",
  "size": [1687, 1100],
  "steps": [
    {"select": ["clip:1/1"]},
    {"click": "id:inspector.tab.captions"},
    {"expect": [{"path": "ui.anchors", "contains": "speakers.section"},
                {"path": "ui.anchors", "contains": "speakers.name.1"},
                {"path": "ui.anchors", "contains": "speakers.name.2"},
                {"path": "project.speakers.count", "equals": 2}]},
    {"snapshot": "speakers-section", "element": "id:panel.inspector", "baseline": "ai_speakers_section"},
    // speaker 2 → cyan (palette 2), only its captions change
    {"click": "id:speakers.color.2.2"},
    {"expect": [{"path": "undo.name", "equals": "cmd.speakerColor"},
                {"path": "project.speakers.1.color.r", "approx": 0.369, "tolerance": 0.01},
                {"path": "tracks.1.clips.1.text", "equals": "Thanks for having me."}]},
    {"key": "cmd+z"},
    {"expect": {"path": "project.speakers.1.color.r", "approx": 1.0, "tolerance": 0.01}},
    {"click": "id:speakers.applyStyle"},
    // same look already: no undo step, but the confirmation toast (the copy itself is unit-tested)
    {"expect": {"path": "ui.toast", "contains": "Style applied"}},
    {"click": "id:speakers.remove"},
    {"expect": [{"path": "project.speakers", "exists": false},
                {"path": "ui.anchors", "contains": "speakers.identify"}]},
    {"snapshot": "speakers-none", "element": "id:panel.inspector"},
    {"key": "cmd+z"},
    {"expect": {"path": "project.speakers.count", "equals": 2}},
    // Auto captions panel option
    {"click": "id:asset.tab.captions"},
    {"click": "id:asset.nav.auto"},
    {"expect": {"path": "ui.anchors", "notContains": "captions.speakerCount"}},
    {"click": "id:captions.identifySpeakers"},
    {"expect": {"path": "ui.anchors", "contains": "captions.speakerCount"}},
    {"snapshot": "captions-identify-speakers", "element": "id:panel.assets", "baseline": "ai_captions_identify_speakers"}
  ]
}
