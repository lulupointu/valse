// Finisher TL-037 / AU-029: click the player timecode, type an absolute then a relative timecode (seeks), invalid
// input is refused; solo the music track from its header (other tracks silenced), undo.
{
  "project": "demo",
  "steps": [
    {"idle": 1},
    {"dump": "start"},
    {"click": "id:player.timecode"},
    {"expect": {"path": "ui.anchors", "contains": "player.timecode.field"}},
    {"type": "00:00:05:00", "replace": true},
    {"key": "return"},
    {"expect": [{"path": "playhead", "approx": 5, "tolerance": 0.01}, {"path": "ui.anchors", "notContains": "player.timecode.field"}]},
    {"click": "id:player.timecode"},
    {"type": "+15", "replace": true},
    {"key": "return"},
    {"expect": {"path": "playhead", "approx": 5.5, "tolerance": 0.01}},
    {"click": "id:player.timecode"},
    {"type": "1000", "replace": true},
    {"key": "return"},
    {"expect": {"path": "playhead", "approx": 10, "tolerance": 0.01}},
    {"snapshot": "timecode", "element": "id:panel.player"},
    {"click": "header:5/solo"},
    {"expect": [{"path": "tracks.5.solo", "equals": true}, {"path": "tracks.5.audible", "equals": true},
                {"path": "main.audible", "equals": false}, {"path": "undo.name", "equals": "cmd.trackSolo"}]},
    {"snapshot": "solo-header", "element": "id:timeline"},
    {"key": "cmd+z"},
    {"expect": [{"path": "tracks.5.solo", "equals": false}, {"path": "main.audible", "equals": true}]}
  ]
}
