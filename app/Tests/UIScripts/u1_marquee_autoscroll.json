// U1-7 (owner: marquee selection "stops until I move again my mouse, is too slow … moves with the timeline when the
// timeline is scrolling, instead of extending"). Zoomed in, a marquee from the empty area under the tracks is held still
// at the right edge: the timeline keeps scrolling on its own (display link, EdgeAutoscroll), the rectangle stays anchored
// at its start time (the first main clip under the start stays selected) and the selection grows live with it.
// Offscreen test windows tick at 4 Hz (occluded), so the scroll is slower here than on screen.
{
  "project": "demo",
  "steps": [
    {"idle": 1},
    {"drag": "id:toolbar.zoomSlider", "at": [0.6, 0.5], "to": "id:toolbar.zoomSlider", "toAt": [0.8, 0.5]},
    {"expect": [{"path": "ui.pixelsPerSecond", "gt": 100}, {"path": "ui.scrollTime", "equals": 0}]},
    {"drag": "id:timeline", "at": [0.12, 0.97], "to": "id:timeline", "toAt": [0.999, 0.62], "steps": 12, "hold": true},
    {"dump": "held-start"},
    {"expect": [{"path": "main.clips.0.selected", "equals": true}, {"path": "main.clips.1.selected", "equals": false}]},
    {"wait": 1.0},
    // the mouse didn't move: the timeline scrolled anyway
    {"expect": [{"path": "ui.scrollTime", "gt": 0.4}, {"path": "main.clips.0.selected", "equals": true}]},
    // the start stays on the first clip while the rectangle extends over the next clip (live selection)
    {"waitFor": {"path": "main.clips.1.selected", "equals": true, "timeout": 30}},
    {"expect": [{"path": "main.clips.0.selected", "equals": true}, {"path": "ui.scrollTime", "gt": 1.5}]},
    {"snapshot": "held", "element": "id:panel.timeline"},
    {"release": true},
    {"expect": [{"path": "main.clips.0.selected", "equals": true}, {"path": "main.clips.1.selected", "equals": true}]}
  ]
}
