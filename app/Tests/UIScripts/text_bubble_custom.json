// TX-BUBBLE2: Text ▸ Bubble laid out like Text ▸ Basic — no-bubble panel; "All" expands the grid, Neon pill, Pink
// neon pill tile; collapsed panel with the preset's sections filled in; ☐ Fill on / off, Outline width, Shape Oval,
// ☐ Tail (bottom-right, Curve), ☐ Neon off / on, Glow; canvas renders of neonPinkPill, the custom bubble, comicShout
// and dashedFrame; Reset back to the preset, one undo brings the edits back.
{
  "project": "demo",
  "steps": [
    {"click": "id:asset.tab.text"},
    {"drop": {"text": "valse.text.default"}, "on": "time:1@2"},
    {"seek": 1.5},
    {"click": "id:inspector.sub.bubble"},
    {"expect": {"path": "selectedClips.0.bubbleID", "exists": false}},
    {"snapshot": "bubble-panel-none", "element": "id:panel.inspector", "baseline": true},
    {"click": "id:text.bubble.all"},
    {"click": "id:text.bubble.group.neon"},
    {"click": "id:text.bubble.tile.neonPinkPill"},
    {"expect": [{"path": "selectedClips.0.bubbleID", "equals": "valse.bubble.neonPinkPill"}, {"path": "undo.name", "equals": "cmd.textBubble"},
                {"path": "selectedClips.0.bubbleStyle", "exists": false}]},
    {"snapshot": "bubble-grid-neon", "element": "id:text.bubble.presets", "baseline": true},
    {"snapshot": "bubble-canvas-neonPinkPill", "element": "id:panel.player", "baseline": true, "threshold": 40, "tolerance": 0.03},
    {"click": "id:text.bubble.all"},
    {"snapshot": "bubble-panel-applied", "element": "id:panel.inspector", "baseline": true},
    {"click": "id:inspector.check.text.bubble.fill"},
    {"expect": [{"path": "selectedClips.0.bubbleStyle.fillAlpha", "equals": 100}, {"path": "undo.name", "equals": "cmd.textBubbleEdit"}]},
    {"click": "id:inspector.check.text.bubble.fill"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.fillAlpha", "equals": 0}},
    {"click": "id:text.bubble.width.field"},
    {"type": "40", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.outline.width", "equals": 80}},
    {"click": "id:text.bubble.shape.oval"},
    {"expect": [{"path": "selectedClips.0.bubbleStyle.family", "equals": "oval"}, {"path": "selectedClips.0.bubbleStyle.contains", "equals": true}]},
    {"click": "id:inspector.check.text.bubble.tail"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.tail.side", "equals": "bottomLeft"}},
    {"click": "id:text.bubble.tail.bottomRight"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.tail.side", "equals": "bottomRight"}},
    {"click": "id:text.bubble.tailKind", "at": [0.5, 0.5]},
    {"expect": {"path": "selectedClips.0.bubbleStyle.tail.kind", "equals": "curve"}},
    {"click": "id:inspector.check.text.bubble.neon"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.outline.neon", "exists": false}},
    {"click": "id:inspector.check.text.bubble.neon"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.outline.neon.glow", "equals": 35}},
    {"click": "id:text.bubble.glow.field"},
    {"type": "50", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.outline.neon.glow", "equals": 50}},
    {"expect": [{"path": "selectedClips.0.bubbleStyle.family", "equals": "oval"}, {"path": "selectedClips.0.bubbleStyle.tail.side", "equals": "bottomRight"}]},
    {"hover": "id:inspector.section.text.bubble.shape.body"},
    {"snapshot": "bubble-customize-shape", "element": "id:inspector.section.text.bubble.shape.body", "baseline": true},
    {"hover": "id:inspector.section.text.bubble.tail.body"},
    {"snapshot": "bubble-customize-style", "element": "id:inspector.section.text.bubble.tail.body", "baseline": true},
    {"snapshot": "bubble-canvas-custom", "element": "id:panel.player", "baseline": true, "threshold": 40, "tolerance": 0.03},
    {"click": "id:text.bubble.all"},
    {"click": "id:text.bubble.group.comic"},
    {"click": "id:text.bubble.tile.comicShout"},
    {"expect": [{"path": "selectedClips.0.bubbleID", "equals": "valse.bubble.comicShout"}, {"path": "selectedClips.0.bubbleStyle", "exists": false}]},
    {"snapshot": "bubble-canvas-comicShout", "element": "id:panel.player", "baseline": true, "threshold": 40, "tolerance": 0.03},
    {"click": "id:text.bubble.group.outline"},
    {"click": "id:text.bubble.tile.dashedFrame"},
    {"expect": {"path": "selectedClips.0.bubbleID", "equals": "valse.bubble.dashedFrame"}},
    {"snapshot": "bubble-canvas-dashedFrame", "element": "id:panel.player", "baseline": true, "threshold": 40, "tolerance": 0.03},
    {"click": "id:text.bubble.shape.burst"},
    {"expect": [{"path": "selectedClips.0.bubbleStyle.family", "equals": "burst"}, {"path": "selectedClips.0.bubbleStyle.outline.width", "equals": 50}]},
    {"click": "id:text.bubble.reset"},
    {"expect": [{"path": "selectedClips.0.bubbleStyle", "exists": false}, {"path": "selectedClips.0.bubbleID", "equals": "valse.bubble.dashedFrame"},
                {"path": "undo.name", "equals": "cmd.textBubbleEdit"}]},
    {"key": "cmd+z"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.family", "equals": "burst"}}
  ]
}
