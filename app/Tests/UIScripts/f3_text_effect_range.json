// TX-040: select part of a text in Text ▸ Basic (the last word), then click a Text effect: only that range takes the
// effect (outline / colours), the rest keeps the clip's look. One undo step.
{
  "project": "demo",
  "steps": [
    {"click": "id:asset.tab.text"},
    {"drop": {"text": "valse.text.default"}, "on": "time:1@2"},
    {"seek": 1.5},
    {"click": "id:text.editor", "at": [0.5, 0.3]},
    {"key": "cmd+right"},
    {"key": "shift+left", "repeat": 4},
    {"click": "id:asset.nav.effects"},
    {"doubleClick": "id:text.tile.valse.textfx.outline.1"},
    {"expect": [{"path": "undo.name", "equals": "cmd.textStyle"}, {"path": "selectedClips.0.text", "equals": "Default text"}, {"path": "project.timeline.tracks.6.clips.0.content.text._0.runs.0.style.effectID", "equals": "valse.textfx.outline.1"}]},
    {"snapshot": "range-effect", "element": "id:panel.player"}
  ]
}
