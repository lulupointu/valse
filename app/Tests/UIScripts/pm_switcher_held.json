// P1 + PM-014: a project open in another Montage window shows "Open in another window" in the switcher; picking it
// brings that window forward (toast) and the current project stays open (never opened twice).
{
  "project": "home:3:heldelsewhere",
  "steps": [
    {"click": "id:home.card.1"},
    {"waitFor": {"path": "app.screen", "equals": "editor", "timeout": 10}},
    {"expect": {"path": "app.projectName", "equals": "Product launch"}},
    {"click": "id:titlebar.projectSwitcher"},
    // row 0 = the current project; the held one (opened most recently) comes next
    {"expect": [{"path": "app.switcher.rows.0.current", "equals": true}, {"path": "app.switcher.rows.1.name", "equals": "Vacances à Biarritz"},
                {"path": "app.switcher.rows.1.status", "equals": "otherWindow"}]},
    {"snapshot": "switcher-held", "element": "id:switcher.popover"},
    {"click": "id:switcher.row.1"},
    {"wait": 0.5},
    {"expect": [{"path": "ui.toast", "contains": "already open"}, {"path": "app.projectName", "equals": "Product launch"},
                {"path": "app.screen", "equals": "editor"}, {"path": "app.switcher.isOpen", "equals": false}]}
  ]
}
