// AI2: Video ▸ Basic ▸ ☐ Relight (UX_AI §4.10). Without the depth model (the default: sandboxed models folder) the
// section offers the Depth Anything download and still relights with the pseudo-depth fallback. Tick → Facial preset +
// background depth pass (progress line), presets / lights list, Creative adds a second light, untick → off.
// The model path is ai_relight_model.json (SKIPPED when the model isn't installed).
{
  "project": "demo",
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"click": "id:inspector.section.video.relight", "at": [0.035, 0.5]},
    {"expect": [{"path": "undo.name", "equals": "cmd.relight"},
                {"path": "ui.anchors", "contains": "relight.preset.facial"}]},
    // the depth model (Core ML spec 8) needs macOS 14: on 13 relight always uses the pseudo-depth fallback, no download offer
    {"minOS": 14, "expect": [{"path": "ui.anchors", "contains": "relight.needsModel"},
                             {"path": "ui.anchors", "contains": "model.download.coreml.depth-anything-v2-small"}]},
    {"maxOS": 13, "expect": [{"path": "ui.anchors", "notContains": "relight.needsModel"},
                             {"path": "ui.anchors", "notContains": "model.download.coreml.depth-anything-v2-small"}]},
    // a fresh pseudo-depth pass of the 6 s clip takes ~65 s in the macOS 13 VM (paravirtual GPU, no ANE: ×11 real time vs ×1.9 measured on the host)
    {"waitFor": {"path": "ui.anchors", "notContains": "relight.progress", "timeout": 150}},
    {"click": "id:relight.preset.creative"},
    {"expect": [{"path": "ui.anchors", "contains": "relight.light.1"}, {"path": "undo.name", "equals": "cmd.relight"}]},
    {"snapshot": "relight-section", "element": "id:panel.inspector", "baseline": true, "tolerance": 0.02},
    {"snapshot": "relight-player", "element": "id:panel.player"},
    {"click": "id:relight.addLight"},
    {"expect": {"path": "ui.anchors", "contains": "relight.light.2"}},
    {"key": "cmd+z"},
    {"expect": {"path": "ui.anchors", "notContains": "relight.light.2"}},
    {"scroll": "id:inspector.section.video.relight", "dx": 0, "dy": 3000},
    {"click": "id:relight.top", "at": [0.02, 0.5], "offset": [0, -22]},
    {"expect": {"path": "ui.anchors", "notContains": "relight.preset.facial"}}
  ]
}
