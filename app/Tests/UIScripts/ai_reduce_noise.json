// W10: Video ▸ Basic ▸ ☐ Reduce image noise renders a denoised copy in the background; the clip then plays it
// (one undo step "Enhance video"); ⌘Z restores the original media.
{
  "project": "demo",
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"scroll": "id:inspector.section.video.stabilize", "dx": 0, "dy": -400},
    {"click": "id:inspector.section.video.denoise", "at": [0.035, 0.5]},
    {"waitFor": {"path": "undo.name", "equals": "cmd.enhance", "timeout": 60}},
    {"snapshot": "denoise", "element": "id:panel.inspector"},
    {"expect": {"path": "media.count", "gt": 3}},
    {"key": "cmd+z"},
    {"expect": {"path": "undo.redoName", "equals": "cmd.enhance"}}
  ]
}
