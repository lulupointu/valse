// AU-030: Text to speech ▸ Style chips. Pick Calm, Generate speech → the linked speech clip stores style "calm" and gets
// the style's post-processing (-2 dB, EQ tilt); editing the script regenerates the speech ("Update speech according to
// script") and keeps the style.
{
  "project": "demo",
  "lang": "en",
  "steps": [
    {"select": ["clip:2/0"]},
    {"expect": {"path": "selectedClips.0.kind", "equals": "text"}},
    {"click": "id:inspector.tab.tts"},
    {"expect": [{"path": "ui.inspectorTab", "equals": "tts"}, {"path": "ui.anchors", "contains": "tts.style.calm"}]},
    {"click": "id:tts.style.calm"},
    {"snapshot": "tts-styles-calm", "element": "id:tts.styles", "baseline": true},
    {"click": "id:tts.generate"},
    {"waitFor": {"path": "tracks.count", "equals": 7, "timeout": 90}},
    {"expect": [{"path": "undo.name", "equals": "cmd.tts"}, {"path": "tracks.last.kind", "equals": "audio"},
                {"path": "project.timeline.tracks.last.clips.0.tts.style", "equals": "calm"},
                {"path": "tracks.last.clips.0.volume", "approx": 0.794, "tolerance": 0.01}]},
    {"click": "id:inspector.tab.text"},
    {"click": "id:text.editor"},
    {"type": "Calm voice test.", "replace": true},
    // the text editor commits every keystroke; the regenerated speech clip is named after the spoken text
    // (waitFor dumps without `project.`, so wait on the clip summary, then check the stored TTSInfo with expect)
    {"waitFor": {"path": "tracks.last.clips.0.name", "equals": "Calm voice test.", "timeout": 90}},
    {"expect": [{"path": "project.timeline.tracks.last.clips.0.tts.text", "equals": "Calm voice test."},
                {"path": "project.timeline.tracks.last.clips.0.tts.style", "equals": "calm"},
                {"path": "undo.name", "equals": "cmd.tts"}, {"path": "tracks.count", "equals": 7}]}
  ]
}
