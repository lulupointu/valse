// TX-026: an LRC file dropped on the app becomes a lyric caption track (Text ▸ Templates offers the Lyrics set); the caption
// templates include the dedicated Lyrics set (unit test F3UITests.lyricTemplatesStyleEveryLine applies one).
{
  "project": "demo",
  "steps": [
    {"drop": {"files": ["fixtures/f3_lyrics.lrc"]}, "on": "time:0@main"},
    {"waitFor": {"path": "undo.name", "equals": "cmd.captionImport", "timeout": 10}},
    {"select": ["clip:1/0"]},
    {"click": "id:inspector.tab.text"},
    {"click": "id:inspector.sub.templates"},
    {"expect": [{"path": "ui.anchors", "contains": "text.templates.caption"}, {"path": "tracks.1.clips.count", "equals": 3}]},
    {"snapshot": "lyric-track", "element": "id:panel.inspector"}
  ]
}
