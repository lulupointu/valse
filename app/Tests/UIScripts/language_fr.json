// Switch the UI language to French from the View menu: the whole UI (and the menu bar) rebuilds without relaunch.
{
  "project": "demo",
  "steps": [
    {"expect": [{"path": "ui.language", "equals": "en"}, {"path": "ui.menu", "contains": "File"}]},
    {"menu": "menu.view/menu.language.fr"},
    {"expect": [{"path": "ui.language", "equals": "fr"}, {"path": "ui.menu", "contains": "Fichier"},
                {"path": "ui.anchors", "contains": "panel.timeline"}]},
    // scoped to the panels whose French labels this checks (a full-window baseline broke on every unrelated chrome
    // change: re-recorded 7×); player / timeline pixels are media renders, covered by their own tests
    {"snapshot": "editor-fr-assets", "element": "id:panel.assets", "baseline": true, "tolerance": 0.0002, "threshold": 40},
    {"snapshot": "editor-fr-inspector", "element": "id:panel.inspector", "baseline": true, "tolerance": 0.0002, "threshold": 40},
    // tolerance 0.02 %: these crops are pure chrome (the video is masked) and render identically run to run on the host
    // (diff 0); one untranslated word ("Player" for "Lecteur") is ~0.08 %. A per-OS baseline still gets >= 1 %.
    // title bar ("Exporter"), player chrome ("Lecteur", timecodes, "Format"; the video itself masked) and the timeline
    // (track headers, "Couverture", clip labels "Chaud 4,0s" with the French decimal comma) — what the old full-window
    // baseline covered, without the unrelated chrome around it
    {"snapshot": "editor-fr-export", "element": "id:titlebar.export", "baseline": true, "tolerance": 0.0002, "threshold": 40},
    {"snapshot": "editor-fr-player", "element": "id:panel.player", "mask": ["id:player"], "baseline": true, "tolerance": 0.0002, "threshold": 40},
    {"snapshot": "editor-fr-timeline", "element": "id:panel.timeline", "baseline": true, "tolerance": 0.0002, "threshold": 40}
  ]
}
