// Audio library (POL-B, UX_GAPS W8-1/W8-2): one sub-nav (Yours · Music · Sound FX · Extracted); Yours lists imported
// music as 56 pt rows with a waveform cover and ⊕; Music is the built-in procedural pack, ⊕ synthesizes, imports and
// adds the track at the playhead.
{
  "project": "demo",
  "steps": [
    {"click": "id:asset.tab.audio"},
    {"wait": 1},
    {"snapshot": "audio-yours", "element": "id:panel.assets", "baseline": "audio_library_yours", "threshold": 40, "tolerance": 0.03},
    {"expect": {"path": "ui.anchors", "contains": "audio.row.0"}},
    {"click": "id:audio.row.0.add"},
    {"expect": [{"path": "undo.depth", "equals": 1}, {"path": "selectedClips.0.name", "equals": "Music"}]},
    {"click": "id:asset.nav.music"},
    {"wait": 0.5},
    {"snapshot": "audio-music", "element": "id:panel.assets", "baseline": "audio_library_music", "threshold": 40, "tolerance": 0.03},
    {"click": "id:audio.music.music.sunrise.add"},
    {"waitFor": {"path": "media.count", "equals": 6, "timeout": 60}},
    {"waitFor": {"path": "undo.depth", "gte": 2, "timeout": 30}},
    {"click": "id:asset.nav.yours"},
    {"wait": 1},
    {"snapshot": "audio-yours-after", "element": "id:panel.assets"}
  ]
}
