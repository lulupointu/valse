// C4 style A ("Instant", Settings ▸ Edit ▸ Labs) + scope: with one main-track clip selected, "Remove filler words"
// cuts only in that clip, at once; the toast's Undo puts everything back.
{
  "project": "demo-transcript",
  "steps": [
    {"idle": 1},
    {"menu": "menu.app/menu.settings"},
    {"click": "id:settings.tab.edit"},
    {"scroll": "id:settings.body", "dx": 0, "dy": -2000},
    {"click": "id:settings.radio.fillerStyle.instant"},
    {"click": "id:dialog.ok"},
    {"expect": {"path": "ui.fillers.style", "equals": "instant"}},
    {"click": "clip:main/1"},
    {"click": "id:toolbar.transcript"},
    {"expect": {"path": "ui.anchors", "contains": "fillers.scope"}},
    {"snapshot": "scope-selected", "element": "id:transcript.panel"},
    {"click": "id:fillers.remove"},
    {"expect": [{"path": "undo.name", "equals": "cmd.removeFillers"}, {"path": "ui.fillers.reviewing", "equals": false},
                {"path": "ui.toast", "contains": "Removed"}, {"path": "ui.anchors", "contains": "toast.action"},
                // clip 1 ("we we talk about captions."): the repetition went, clip 0's "euh" stayed
                {"path": "ui.transcript.words", "contains": "euh"}, {"path": "ui.transcript.words", "contains": "um"}]},
    {"dump": "after"},
    {"click": "id:toast.action"},
    {"expect": {"path": "undo.name", "notEquals": "cmd.removeFillers"}}
  ]
}
