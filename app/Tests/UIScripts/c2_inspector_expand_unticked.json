// C2: ▼ on an unticked option (Stabilize, Auto reframe, Chroma key…) expands it and shows its settings without
// switching it on; ticking still applies it (CapCut).
{
  "project": "demo",
  "steps": [
    {"click": "time:1@ruler"},
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"expect": [{"path": "ui.anchors", "contains": "inspector.section.video.stabilize"},
                {"path": "ui.anchors", "notContains": "inspector.section.video.stabilize.body"}]},
    {"click": "id:inspector.section.video.stabilize", "at": [0, 0.5], "offset": [90, 0]},
    {"expect": [{"path": "ui.anchors", "contains": "inspector.section.video.stabilize.body"},
                {"path": "undo.depth", "equals": 0}]},
    {"snapshot": "stabilize-expanded-off", "element": "id:panel.inspector"},
    {"click": "id:inspector.sub.cutout"},
    {"click": "id:inspector.section.cutout.chroma", "at": [0, 0.5], "offset": [90, 0]},
    {"expect": [{"path": "ui.anchors", "contains": "inspector.section.cutout.chroma.body"},
                {"path": "selectedClips.0.effects", "notContains": "valse.key.chroma"}, {"path": "undo.depth", "equals": 0}]},
    {"snapshot": "chroma-expanded-off", "element": "id:panel.inspector"},
    {"click": "id:inspector.section.cutout.chroma", "at": [0, 0], "offset": [20, 25]},
    {"expect": [{"path": "undo.name", "equals": "cmd.chromaKey"}, {"path": "selectedClips.0.effects", "contains": "valse.key.chroma"},
                {"path": "ui.anchors", "contains": "inspector.section.cutout.chroma.body"}]}
  ]
}
