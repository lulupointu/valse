// P1 + PM-009: a project on a drive that isn't connected is dimmed in the switcher ("Drive offline"); picking it
// explains why (error toast) and the current project stays open.
{
  "project": "home:3:offlinedrive",
  "steps": [
    {"click": "id:home.card.0"},
    {"waitFor": {"path": "app.screen", "equals": "editor", "timeout": 10}},
    {"click": "id:titlebar.projectSwitcher"},
    {"expect": [{"path": "app.switcher.rows.count", "equals": 3}, {"path": "app.switcher.rows.2.name", "equals": "Wedding teaser"},
                {"path": "app.switcher.rows.2.status", "equals": "offline"}]},
    {"snapshot": "switcher-offline", "element": "id:switcher.popover"},
    {"click": "id:switcher.row.2"},
    {"wait": 0.5},
    {"expect": [{"path": "ui.toast", "contains": "isn't connected"}, {"path": "app.projectName", "equals": "Vacances à Biarritz"},
                {"path": "app.screen", "equals": "editor"}]}
  ]
}
