// CL-019 / AI-021: Video ▸ Basic ▸ ☐ Enhance quality renders a super-resolved copy (tiled low-latency scaler, faster
// than real time; it used to take ×50 real time) in the background; the clip then plays it (one undo step).
{
  "project": "demo",
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"scroll": "id:inspector.section.video.stabilize", "dx": 0, "dy": -400},
    {"click": "id:inspector.section.video.enhanceQuality", "at": [0.035, 0.5]},
    // VideoToolbox super resolution needs macOS 26: before, the section is disabled ("Available for videos up to 1080p")
    {"maxOS": 25, "expect": [{"path": "undo.depth", "equals": 0}, {"path": "media.count", "equals": 5}]},
    {"minOS": 26, "waitFor": {"path": "undo.name", "equals": "cmd.enhance", "timeout": 30}},
    {"snapshot": "enhance_quality", "element": "id:panel.inspector"},
    {"minOS": 26, "expect": {"path": "media.count", "gt": 3}},
    {"minOS": 26, "key": "cmd+z"},
    {"minOS": 26, "expect": {"path": "undo.redoName", "equals": "cmd.enhance"}}
  ]
}
