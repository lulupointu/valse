// OB-07 (fr): AI remove without LaMa → Supprimer asks to download the model ("Téléchargement nécessaire", name + size)
// → Télécharger → bottom-right progress → when the (simulated, offline) download finishes the indicator goes away and
// the removal proceeds by itself (its job starts; without real weights it then fails, which is not checked here).
{
  "project": "demo",
  "lang": "fr",
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"scroll": "id:inspector.section.video.stabilize", "dx": 0, "dy": -800},
    {"click": "id:inspector.section.video.aiRemove", "at": [0.035, 0.5]},
    {"drag": "player:0.3,0.5", "to": "player:0.4,0.55", "steps": 8},
    {"click": "id:remove.apply"},
    {"waitFor": {"path": "ui.models.flow.prompt", "equals": "coreml.lama-800"}},
    {"snapshot": "model-prompt-fr", "element": "id:modelPrompt", "baseline": true},
    {"click": "id:modelPrompt.download"},
    {"waitFor": {"path": "ui.models.flow.prompt", "equals": ""}},
    {"waitFor": {"path": "ui.models.flow.proceeded", "equals": 1}},
    {"expect": [{"path": "ui.models.coreml_lama-800", "equals": "installed"},
                {"path": "ui.models.flow.pending", "equals": 0},
                {"path": "ui.models.flow.active", "equals": ""},
                {"path": "ui.anchors", "notContains": "modelDownloads.indicator"}]},
    {"waitFor": {"path": "ui.activeJobs", "equals": 0, "timeout": 120}}
  ]
}
