// C4: Inspector ▸ Captions follows CapCut [17]: Captions is the first tab, rows are number + text (no timing steppers),
// the selected / hovered row shows ＋ (add a caption after) and 🗑 (delete); each is one undo step.
{
  "project": "demo-transcript:captions",
  "steps": [
    {"select": ["clip:1/0"]},
    {"expect": [{"path": "ui.inspectorTabs.0", "equals": "captions"}]},
    {"click": "id:inspector.tab.captions"},
    {"expect": [{"path": "ui.anchors", "contains": "captions.row.3"}, {"path": "ui.anchors", "contains": "captions.search"},
                {"path": "ui.anchors", "contains": "captions.add.1"}]},
    {"snapshot": "caption-list", "element": "id:panel.inspector"},
    {"click": "id:captions.add.1"},
    {"expect": [{"path": "undo.name", "equals": "cmd.captionAdd"}, {"path": "ui.transcript.captions.count", "equals": 4},
                {"path": "ui.transcript.captions.1.text", "equals": "New caption"},
                {"path": "ui.transcript.captions.2.text", "equals": "we we talk about captions."}]},
    {"click": "id:captions.delete.2"},
    {"expect": [{"path": "undo.name", "equals": "cmd.captionDelete"}, {"path": "ui.transcript.captions.count", "equals": 3}]},
    {"key": "cmd+z"},
    {"key": "cmd+z"},
    {"expect": {"path": "ui.transcript.captions.count", "equals": 3}},
    {"expect": {"path": "ui.transcript.captions.1.text", "equals": "we we talk about captions."}}
  ]
}
