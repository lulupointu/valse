// U1-2 (owner: "Settings: we can scroll left to right everywhere"): every Settings tab fits the dialog width — no
// horizontal scrolling (content width = visible width, no sideways rubber-band, the horizontal offset stays 0 during and
// after a sideways wheel scroll / trackpad swipe) —
// French (the English run is u1_settings_no_hscroll). U1-4: the dialog title has no ellipsis ("Settings", "Paramètres"; the menu item keeps "…").
{
  "project": "home",
  "lang": "fr",
  "steps": [
    {"click": "id:home.top.settings"},
    {"expect": {"path": "app.modal", "equals": "settings"}},
    {"click": "id:settings.tab.general"},
    {"scroll": "id:settings.body", "dx": -400, "dy": 0},
    {"scroll": "id:settings.body", "dx": 0, "dy": 0, "phase": "began", "settle": 0},
    {"scroll": "id:settings.body", "dx": -60, "dy": 0, "phase": "changed", "repeat": 5, "settle": 0},
    {"expect": [{"path": "ui.settings.overflow", "lte": 0}, {"path": "ui.settings.innerOverflow", "lte": 0},
                {"path": "ui.settings.horizontallyElastic", "equals": 0}, {"path": "ui.settings.scrollX", "approx": 0, "tolerance": 0.5},
                {"path": "ui.settings.innerScrollX", "approx": 0, "tolerance": 0.5}]},
    {"scroll": "id:settings.body", "dx": 0, "dy": 0, "phase": "ended"},
    {"snapshot": "fr-general", "element": "id:settings"},
    {"click": "id:settings.tab.project"},
