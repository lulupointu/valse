// TX-BUBBLE2 padding: Horizontal + Vertical rows (% of the font size) with a chain, linked by default: linked, one
// value scales the other by the same ratio (by the same amount when the other is 0); unlinked they move separately;
// relinking keeps the values. 0 = the oval touches the text box (canvas), negative = it hugs the text. One undo step.
{
  "project": "demo",
  "steps": [
    {"click": "id:asset.tab.text"},
    {"drop": {"text": "valse.text.default"}, "on": "time:1@2"},
    {"seek": 1.5},
    {"click": "id:inspector.sub.bubble"},
    {"click": "id:text.bubble.group.neon"},
    {"click": "id:text.bubble.tile.neonRedOval"},
    {"expect": {"path": "selectedClips.0.bubbleID", "equals": "valse.bubble.neonRedOval"}},
    {"click": "id:text.bubble.customize"},
    {"click": "id:text.bubble.paddingH.field"},
    {"type": "80", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padX", "equals": 800}},
    {"expect": [{"path": "selectedClips.0.bubbleStyle.padY", "equals": 400}, {"path": "undo.name", "equals": "cmd.textBubbleEdit"}]},
    {"click": "id:text.bubble.paddingLink"},
    {"click": "id:text.bubble.paddingV.field"},
    {"type": "0", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padY", "equals": 0}},
    {"expect": {"path": "selectedClips.0.bubbleStyle.padX", "equals": 800}},
    {"hover": "id:text.bubble.styleRows"},
    {"snapshot": "bubble-padding-unlinked", "element": "id:text.bubble.styleRows", "baseline": true},
    {"click": "id:text.bubble.paddingLink"},
    {"expect": [{"path": "selectedClips.0.bubbleStyle.padX", "equals": 800}, {"path": "selectedClips.0.bubbleStyle.padY", "equals": 0}]},
    {"click": "id:text.bubble.paddingH.field"},
    {"type": "40", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padX", "equals": 400}},
    {"expect": {"path": "selectedClips.0.bubbleStyle.padY", "equals": -400}},
    {"click": "id:text.bubble.paddingLink"},
    {"click": "id:text.bubble.paddingV.field"},
    {"type": "0", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padY", "equals": 0}},
    {"click": "id:text.bubble.paddingH.field"},
    {"type": "0", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padX", "equals": 0}},
    {"expect": {"path": "selectedClips.0.bubbleStyle.padY", "equals": 0}},
    {"snapshot": "bubble-canvas-padding0", "element": "id:panel.player", "baseline": true, "threshold": 40, "tolerance": 0.03},
    {"click": "id:text.bubble.paddingLink"},
    {"click": "id:text.bubble.paddingH.field"},
    {"type": "-20", "replace": true},
    {"key": "return"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padX", "equals": -200}},
    {"expect": {"path": "selectedClips.0.bubbleStyle.padY", "equals": -200}},
    {"key": "cmd+z"},
    {"waitFor": {"path": "selectedClips.0.bubbleStyle.padX", "equals": 0}}
  ]
}
