// C4 style C ("Inline", Settings ▸ Edit ▸ Labs): from the Captions tab entry point (Captions ▸ Filler words, the same
// review surface as the Transcript panel), the fillers and pauses are highlighted in the transcript; clicking one keeps
// it, Apply cuts the others.
{
  "project": "demo-transcript:captions",
  "steps": [
    {"idle": 1},
    {"menu": "menu.app/menu.settings"},
    {"click": "id:settings.tab.edit"},
    {"scroll": "id:settings.body", "dx": 0, "dy": -2000},
    {"click": "id:settings.radio.fillerStyle.inline"},
    {"snapshot": "settings-labs", "element": "id:settings"},
    {"click": "id:dialog.ok"},
    {"expect": [{"path": "app.settings.fillerRemovalStyle", "equals": "inline"}, {"path": "ui.fillers.style", "equals": "inline"}]},
    {"click": "id:asset.tab.captions"},
    {"click": "id:asset.nav.fillers"},
    {"click": "id:fillers.remove"},
    {"expect": [{"path": "ui.fillers.reviewing", "equals": true}, {"path": "ui.fillers.reviewStyle", "equals": "inline"},
                {"path": "ui.anchors", "contains": "fillers.word.1"}, {"path": "ui.anchors", "contains": "fillers.pause.0"}]},
    {"snapshot": "fillers-inline", "element": "id:panel.assets"},
    // keep "euh" (word 1)
    {"click": "id:fillers.word.1"},
    {"snapshot": "fillers-inline-kept", "element": "id:transcript.text"},
    {"click": "id:fillers.apply"},
    {"expect": [{"path": "undo.name", "equals": "cmd.removeFillers"}, {"path": "ui.transcript.words", "contains": "euh"},
                {"path": "ui.transcript.words", "notContains": "um"}]},
    // captions followed the cuts: the first caption starts right before its first word
    {"expect": {"path": "ui.transcript.captions.0.start", "lt": 0.2}},
    {"snapshot": "after-inline", "element": "id:panel.timeline"}
  ]
}
