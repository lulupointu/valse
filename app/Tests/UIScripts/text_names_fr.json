// Text (POL-B, UX_GAPS W7-2/W7-3): French text effect names and text animation names fit their tiles (no "Machi…écrire").
{
  "project": "demo",
  "lang": "fr",
  "size": [1687, 2300],
  "steps": [
    {"click": "id:asset.tab.text"},
    {"click": "id:asset.nav.effects"},
    {"wait": 1.5},
    {"snapshot": "text-effects-fr", "element": "id:panel.assets"},
    {"drop": {"text": "valse.text.default"}, "on": "time:12@2"},
    {"click": "id:inspector.tab.animation"},
    {"wait": 2},
    {"snapshot": "anim-in-fr", "element": "id:panel.inspector", "baseline": "text_animation_tiles_fr", "threshold": 40, "tolerance": 0.03},
    {"click": "id:inspector.sub.out"},
    {"wait": 2},
    {"snapshot": "anim-out-fr", "element": "id:panel.inspector"},
    {"click": "id:inspector.sub.loop"},
    {"wait": 2},
    {"snapshot": "anim-loop-fr", "element": "id:panel.inspector"}
  ]
}
