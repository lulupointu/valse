// Stickers tab: open Shapes, ⊕ adds a vector shape sticker clip; it renders in the player.
{
  "project": "demo",
  "steps": [
    {"click": "id:asset.tab.stickers"},
    {"click": "id:asset.nav.sticker.group.shapes"},
    {"expect": {"path": "ui.anchors", "contains": "asset.tile.montage.sticker.shape.circle.white"}},
    {"hover": "id:asset.tile.montage.sticker.shape.circle.white"},
    {"click": "id:asset.tile.montage.sticker.shape.circle.white"},
    {"click": "id:asset.tile.montage.sticker.shape.circle.white.add"},
    {"expect": [{"path": "undo.depth", "equals": 1}, {"path": "selectedClips.0.kind", "contains": "sticker"}]},
    {"snapshot": "sticker-added", "element": "id:panel.player"}
  ]
}
