// F4 AI-041: AI remove on a long source. A 40 s recording (red "logo" box) is too long while the clip uses all of it
// (no AI remove section); cut to 8 s, the section appears, the brushed logo is removed from the clip's part only
// (frames outside it are copied) with temporal smoothing of the fill.
{
  "project": "empty",
  "requires": {"models": ["coreml.lama-800"]},
  "steps": [
    {"drop": {"files": ["fixtures/remove/long_logo.mp4"]}, "on": "time:0@main"},
    {"waitFor": {"path": "main.clips.count", "equals": 1, "timeout": 20}},
    {"wait": 1.0},
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"expect": {"path": "ui.anchors", "notContains": "inspector.section.video.aiRemove"}},
    {"seek": 8},
    {"key": "cmd+b"},
    {"click": "clip:main/1"},
    {"key": "delete"},
    {"expect": {"path": "main.clips.0.duration", "approx": 8, "tolerance": 0.25}},
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"scroll": "id:inspector.section.video.stabilize", "dx": 0, "dy": -800},
    {"expect": {"path": "ui.anchors", "contains": "inspector.section.video.aiRemove"}},
    {"click": "id:inspector.section.video.aiRemove", "at": [0.035, 0.5]},
    {"seek": 2},
    {"drag": "player:0.42,0.44", "to": "player:0.58,0.56", "steps": 10},
    {"drag": "player:0.58,0.44", "to": "player:0.42,0.56", "steps": 10},
    {"drag": "player:0.42,0.5", "to": "player:0.58,0.5", "steps": 10},
    {"drag": "player:0.40,0.40", "to": "player:0.60,0.40", "steps": 10},
    {"drag": "player:0.40,0.60", "to": "player:0.60,0.60", "steps": 10},
    {"snapshot": "remove-long-brush", "element": "id:panel.player"},
    {"click": "id:remove.apply"},
    {"waitFor": {"path": "undo.name", "equals": "cmd.aiRemove", "timeout": 240}},
    {"seek": 4},
    {"wait": 1.5},
    {"snapshot": "remove-long-result", "element": "id:panel.player"}
  ]
}
