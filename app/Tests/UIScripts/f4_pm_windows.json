// F4 PM-014: File ▸ New Window starts another Montage window (recorded in UI tests); opening a project that is open in
// another window brings that window forward (toast) instead of opening it twice.
{
  "project": "home:3:heldelsewhere",
  "steps": [
    {"menu": "menu.file/pm.window.new"},
    {"expect": {"path": "app.launchedWindows.count", "equals": 1}},
    {"doubleClick": "id:home.card.0"},
    {"wait": 0.5},
    {"expect": [{"path": "app.screen", "equals": "home"}, {"path": "ui.toast", "contains": "already open"}]},
    {"snapshot": "f4-pm-window-already-open"}
  ]
}
