// AI2: quitting while a Core ML job is mid-inference must not crash (STATUS cross-team row: LaMa AI remove + exit
// crashed in MPSGraph during the exit teardown). The script ends right after starting the inpainting job; the app then
// cancels every job, waits for the running inference to return and exits cleanly (exit code 0 = no crash).
// SKIPPED when the LaMa model isn't installed.
{
  "project": "demo",
  "requires": {"models": ["coreml.lama-800"]},
  "steps": [
    {"click": "clip:main/0"},
    {"click": "id:inspector.tab.video"},
    {"scroll": "id:inspector.section.video.stabilize", "dx": 0, "dy": -800},
    {"click": "id:inspector.section.video.aiRemove", "at": [0.035, 0.5]},
    {"drag": "player:0.3,0.5", "to": "player:0.4,0.55", "steps": 8},
    {"click": "id:remove.apply"},
    {"waitFor": {"path": "ui.anchors", "contains": "remove.progress", "timeout": 10}},
    {"wait": 1.5}
  ]
}
