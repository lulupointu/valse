// TX-BUBBLE2: the Bubble tab in French — no-bubble panel (Forme + hint, ☐ Remplissage / Contour / Néon / Ombre,
// Marge), "Tout (63)" grid with filter pills and tile names, then a burst with a tail and a shadow: the sections
// (Forme, Bord, Queue, Ombre, Marge) fit the inspector.
{
  "project": "demo",
  "lang": "fr",
  "steps": [
    {"click": "id:asset.tab.text"},
    {"drop": {"text": "valse.text.default"}, "on": "time:1@2"},
    {"click": "id:inspector.sub.bubble"},
    {"expect": {"path": "selectedClips.0.bubbleID", "exists": false}},
    {"snapshot": "bubble-panel-none-fr", "element": "id:panel.inspector", "baseline": true},
    {"click": "id:text.bubble.all"},
    {"click": "id:text.bubble.group.comic"},
    {"click": "id:text.bubble.tile.comicShout"},
    {"expect": {"path": "selectedClips.0.bubbleID", "equals": "valse.bubble.comicShout"}},
    {"snapshot": "bubble-grid-comic-fr", "element": "id:text.bubble.presets", "baseline": true},
    {"click": "id:text.bubble.all"},
    {"click": "id:inspector.check.text.bubble.shadow"},
    {"expect": {"path": "selectedClips.0.bubbleStyle.shadow", "equals": "soft"}},
    {"snapshot": "bubble-panel-applied-fr", "element": "id:panel.inspector", "baseline": true},
    {"hover": "id:inspector.section.text.bubble.shape.body"},
    {"snapshot": "bubble-customize-shape-fr", "element": "id:inspector.section.text.bubble.shape.body", "baseline": true},
    {"hover": "id:inspector.section.text.bubble.padding.body"},
    {"snapshot": "bubble-customize-style-fr", "element": "id:inspector.section.text.bubble.tail.body", "baseline": true}
  ]
}
