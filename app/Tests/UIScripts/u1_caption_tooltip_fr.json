// U1-5 → CAP-EDITOR-UX: the double-click-the-number tooltip is gone; the active row's ↻ / + buttons have French
// tooltips ("Rejouer la ligne", "Insérer après"). U1-3: the tab reads "Sous-titres".
{
  "project": "demo-transcript:captions",
  "lang": "fr",
  "steps": [
    {"select": ["clip:1/0"]},
    {"click": "id:inspector.tab.captions"},
    {"expect": {"path": "ui.anchors", "contains": "captions.row.2"}},
    {"hover": "id:captions.replay.1"},
    {"waitFor": {"path": "ui.tooltip", "equals": "Rejouer la ligne"}},
    {"hover": "id:captions.add.1"},
    {"waitFor": {"path": "ui.tooltip", "equals": "Insérer après"}},
    {"snapshot": "captions-fr", "element": "id:panel.inspector"},
    {"snapshot": "assets-fr", "element": "id:panel.assets"}
  ]
}
