// Media tab (W13): bin cards with thumbnails, multi-select (⌘ click) + Return adds both at the playhead, "Added"
// badges, ☆ favourite shows in Favorites, ⊕ adds, list view, search filters the bin.
{
  "project": "demo-bin",
  "settle": 2.5,
  "steps": [
    {"expect": [{"path": "media.count", "equals": 5}, {"path": "ui.assets.tab", "equals": "media"}]},
    {"wait": 1.5},
    {"snapshot": "media-grid", "element": "id:panel.assets"},
    {"click": "id:media.card.0"},
    {"click": "id:media.card.1", "modifiers": ["cmd"]},
    {"expect": [{"path": "ui.assets.mediaSelection.count", "equals": 2}, {"path": "ui.assets.keyboardTab", "equals": "media"}]},
    {"key": "return"},
    {"expect": [{"path": "main.clips.count", "equals": 2}, {"path": "selectedClips.count", "equals": 2}]},
    {"wait": 0.5},
    {"snapshot": "media-added", "element": "id:panel.assets"},
    // ☆ on the cursor card (buttons show on the keyboard cursor too)
    {"click": "id:media.card.2"},
    {"click": "id:media.card.favorite"},
    {"expect": {"path": "ui.assets.favorites.media.count", "equals": 1}},
    {"click": "id:asset.nav.favorites"},
    {"expect": [{"path": "ui.assets.nav.media", "equals": "favorites"}, {"path": "ui.assets.count.media", "equals": 1}]},
    {"snapshot": "media-favorites", "element": "id:panel.assets"},
    {"click": "id:asset.nav.import"},
    // search (debounced) lists matching bin items
    {"click": "id:asset.search"},
    {"type": "Music"},
    {"wait": 0.5},
    {"expect": [{"path": "ui.assets.query.media", "equals": "Music"}, {"path": "ui.assets.count.media", "equals": 1}]},
    {"snapshot": "media-search", "element": "id:panel.assets"},
    {"click": "id:asset.search.clear"},
    {"expect": {"path": "ui.assets.query.media", "equals": ""}},
    // list view
    {"click": "id:media.layout"},
    {"expect": {"path": "ui.assets.media.layout", "equals": "list"}},
    {"snapshot": "media-list", "element": "id:panel.assets"},
    {"click": "id:media.layout"}
  ]
}
