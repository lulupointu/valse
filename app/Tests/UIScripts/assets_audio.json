// Audio tab: offline library rows — ☆ favourite → Favorites, debounced local search, a library sound effect dropped on
// the timeline (valse-lib payload). (No generated / synthesized audio any more: owner decision; see audio_library.json
// and audio_online.json for the rest.)
{
  "project": "empty",
  "requires": {"content": true},
  "steps": [
    {"click": "id:asset.tab.audio"},
    {"expect": [{"path": "ui.assetTab", "equals": "audio"}, {"path": "ui.assets.count.audio", "gte": 40}]},
    {"snapshot": "audio-music", "element": "id:panel.assets"},
    {"click": "id:asset.nav.music.cat.chill"},
    {"expect": {"path": "ui.assets.count.audio", "gte": 3}},
    {"click": "id:asset.search"},
    {"type": "jazz"},
    {"wait": 0.5},
    {"expect": [{"path": "ui.assets.query.audio", "equals": "jazz"}, {"path": "ui.assets.count.audio", "gte": 3}]},
    {"click": "id:asset.search.clear"},
    {"click": "id:asset.nav.music.cat.vlog"},
    {"click": "id:asset.tile.lib.freepd.fresh-focus.favorite"},
    {"expect": {"path": "ui.assets.favorites.audio.0", "equals": "lib.freepd.fresh-focus"}},
    {"click": "id:asset.nav.favorites"},
    {"expect": {"path": "ui.assets.count.audio", "equals": 1}},
    {"drop": {"string": "valse-lib:sfx.transition.swish-1"}, "on": "time:0@ruler", "offset": [0, 120]},
    {"waitFor": {"path": "media.count", "equals": 1, "timeout": 20}},
    {"expect": {"path": "tracks.count", "gte": 2}},
    {"click": "id:asset.nav.sfx.cat.transition"},
    {"snapshot": "audio-sfx", "element": "id:panel.assets"}
  ]
}
