// CAP-EDITOR-UX pinned tools: the editor shows with nothing selected; search highlights (list not filtered) with a
// "n/N" counter and Enter = next match (row active); Replace = the current match only; Split options re-cut the
// whole language at once (one undo step, CAP-UX2-SPLIT); ↻ replays the line and pauses at its end.
// FLAKY-UI4: Return stepped to the PREVIOUS match ("matchIndex 2") when Shift was held on the real keyboard while the
// test ran: the field read the hardware modifier state (NSEvent.modifierFlags), now the key event's own (EventModifiers).
{
  "project": "demo-transcript:captions",
  "steps": [
    {"expect": [{"path": "selection.count", "equals": 0}, {"path": "ui.inspectorTabs", "contains": "captions"}]},
    {"click": "id:inspector.tab.captions"},
    {"waitFor": {"path": "ui.captionEditor.count", "equals": 3}},
    {"click": "id:captions.search"},
    {"type": "we"},
    {"waitFor": {"path": "ui.captionEditor.matches", "equals": 3}},
    {"expect": [{"path": "ui.captionEditor.count", "equals": 3}, {"path": "ui.anchors", "contains": "captions.search.count"}]},
    {"key": "return"},
    {"waitFor": {"path": "ui.captionEditor.matchIndex", "equals": 1}},
    {"waitFor": {"path": "ui.captionEditor.active", "equals": 1}},
    {"snapshot": "cap-editor-search", "element": "id:captions.editor", "mask": ["id:captions.search"], "baseline": true},
    // replace only the current match
    {"click": "id:captions.replace"},
    {"waitFor": {"path": "ui.anchors", "contains": "captions.replace.field"}},
    {"click": "id:captions.replace.field"},
    {"type": "us"},
    {"click": "id:captions.replace.one"},
    {"waitFor": {"path": "ui.captionEditor.texts.1", "equals": "us we talk about captions."}},
    // (state published by separate refreshes under load: wait for each, never expect right after one)
    {"waitFor": {"path": "undo.name", "equals": "cmd.captionReplace"}},
    {"waitFor": {"path": "ui.captionEditor.matches", "equals": 2}},
    {"expect": [{"path": "ui.captionEditor.texts.0", "equals": "Hello euh welcome to the show. Today"}]},
    {"key": "cmd+z"},
    {"waitFor": {"path": "ui.captionEditor.texts.1", "equals": "we we talk about captions."}},
    // split options (CAP-UX2-SPLIT): a rule applies at once (no confirmation), one undo step; a longer rule after a
    // shorter one merges again (it used to do nothing); the current rule again is a no-op
    {"click": "id:captions.split"},
    {"waitFor": {"path": "ui.captionEditor.splitOpen", "equals": true}},
    {"click": "id:captions.split.0"},
    {"waitFor": {"path": "ui.captionEditor.split", "equals": "1x16"}},
    {"waitFor": {"path": "ui.captionEditor.count", "gt": 5}},
    {"waitFor": {"path": "undo.name", "equals": "cmd.captionWrap"}},
    {"expect": [{"path": "ui.anchors", "notContains": "captions.split.confirm"}]},
    {"click": "id:captions.split.3"},
    {"waitFor": {"path": "ui.captionEditor.split", "equals": "2x42"}},
    {"waitFor": {"path": "ui.captionEditor.count", "lte": 4}},
    {"waitFor": {"path": "undo.depth", "equals": 2}},
    {"click": "id:captions.split.3"},
    {"expect": [{"path": "undo.depth", "equals": 2}, {"path": "ui.captionEditor.split", "equals": "2x42"}]},
    {"key": "cmd+z"},
    {"waitFor": {"path": "ui.captionEditor.split", "equals": "1x16"}},
    {"key": "cmd+z"},
    {"waitFor": {"path": "ui.captionEditor.count", "equals": 3}},
    {"click": "id:captions.split"},
    {"waitFor": {"path": "ui.captionEditor.splitOpen", "equals": false}},
    // ↻ replay line: plays the caption then pauses at its end
    {"click": "id:captions.row.2", "at": [0.03, 0.5]},
    {"waitFor": {"path": "ui.captionEditor.active", "equals": 1}},
    {"click": "id:captions.replay.2"},
    {"waitFor": {"path": "ui.captionEditor.nowPlayingIndex", "equals": 1, "timeout": 60}},
    {"waitFor": {"path": "isPlaying", "equals": false, "timeout": 60, "progress": ["playhead"]}},
    {"expect": [{"path": "ui.captionEditor.nowPlayingIndex", "equals": 1}, {"path": "ui.captionEditor.active", "equals": 1}]}
  ]
}
